{
  "name": "kanji-wizards-desktop",
  "productName": "Kanji Wizards",
  "version": "0.9.9.4",
  "description": "Kanji Wizards for Windows",
  "author": "Kanji Wizards",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.kanjiwizards.app",
    "productName": "Kanji Wizards",
    "copyright": "Kanji Wizards",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "KanjiWizards-Setup.exe" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kanji Wizards",
      "runAfterFinish": true
    }
  }
}
