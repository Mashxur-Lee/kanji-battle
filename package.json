{
  "name": "kanji-battle",
  "version": "0.9.9.4.4",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "npm run build:client && tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "three": "0.169.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.169.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
