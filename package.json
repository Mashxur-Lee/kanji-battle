{
  "name": "kanji-battle",
  "version": "0.9.9.9.9.6",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:compress": "node scripts/precompress.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:compress",
    "dev": "npm run build:client && tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test-results/lcov.info test/*.test.ts",
    "test:report": "playwright show-report test-results/e2e-report"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "three": "0.169.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.169.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
